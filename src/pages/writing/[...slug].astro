---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Exchange from '../../components/Exchange.astro';
import Turn from '../../components/Turn.astro';
import Figure from '../../components/Figure.astro';
import { SITE } from '../../site.config';
import { getPosts, formatDate, readingTime, titleTransition } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  // Posts are sorted newest first, so the next-newer post is at i - 1.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
const sections = headings.filter((h) => h.depth === 2);
const { links } = SITE;
const reply = [
  { label: 'email', url: links.email && `mailto:${links.email}` },
  { label: links.social.label.toLowerCase(), url: links.social.url },
  { label: 'linkedin', url: links.linkedin },
  { label: 'github', url: links.github },
].filter((l) => l.url);
---

<Base title={title} description={description} ogImage={`/og/${post.id}.png`} type="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={pubDate.toISOString()} />
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
  </Fragment>

  <article>
    <header>
      <h1 style={titleTransition(post.id)}>{title}</h1>
      <p class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'long')}</time>
        {updatedDate && <span> · updated {formatDate(updatedDate, 'long')}</span>}
        <span> · {readingTime(post.body)} min read</span>
        {draft && <span class="draft"> · draft</span>}
      </p>
      {tags.length > 0 && <p class="meta tags">tagged {tags.join(' · ')}</p>}
    </header>

    {
      sections.length >= 4 && (
        <details class="toc" open>
          <summary class="meta">contents ({sections.length} sections)</summary>
          <ol>
            {sections.map((h) => (
              <li>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    {
      sections.length >= 4 && (
        <nav class="toc-side" aria-label="Contents">
          <div class="toc-side-inner">
            <p class="meta">contents</p>
            <ol>
              {sections.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
      )
    }

    <div class="prose">
      <Content components={{ Exchange, Turn, Figure }} />
    </div>
  </article>

  <aside class="after" aria-label="After this post">
    <h2 class="section-label">follow</h2>
    <p>
      New posts go out on the <a href="/rss.xml">RSS feed</a>.{' '}
      {
        reply.length > 0 && (
          <>
            For questions or corrections, reach me on{' '}
            {reply.map((l, i) => (
              <>
                {i > 0 && (i === reply.length - 1 ? ' or ' : ', ')}
                <a href={l.url}>{l.label}</a>
              </>
            ))}
            .
          </>
        )
      }
    </p>
  </aside>

  <nav class="pager meta" aria-label="More writing">
    {
      older && (
        <a class="older" href={`/writing/${older.id}/`}>
          <span>← older</span>
          {older.data.title}
        </a>
      )
    }
    {
      newer && (
        <a class="newer" href={`/writing/${newer.id}/`}>
          <span>newer →</span>
          {newer.data.title}
        </a>
      )
    }
    <a class="all" href="/writing/">← all writing</a>
  </nav>
  <p class="sr-only" role="status" id="copy-status"></p>
</Base>

<script>
  // The contents list renders open; collapse it on narrow screens so the intro stays near the top.
  if (matchMedia('(max-width: 40rem)').matches) document.querySelector('.toc')?.removeAttribute('open');

  for (const h of document.querySelectorAll<HTMLHeadingElement>('.prose h2[id], .prose h3[id]')) {
    const a = document.createElement('a');
    a.className = 'heading-anchor';
    a.href = `#${h.id}`;
    a.textContent = '#';
    a.setAttribute('aria-label', `Link to section: ${h.textContent}`);
    h.append(a);
  }

  for (const table of document.querySelectorAll<HTMLTableElement>('.prose table')) {
    const wrap = document.createElement('div');
    wrap.className = 'table-wrap';
    table.replaceWith(wrap);
    wrap.append(table);
  }

  // Highlight the section being read in the side contents list (wide screens only).
  const sideLinks = [...document.querySelectorAll<HTMLAnchorElement>('.toc-side a')];
  const sectionHeadings = sideLinks
    .map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))))
    .filter((h): h is HTMLElement => h !== null);
  if (sideLinks.length > 0) {
    let frame = 0;
    const update = () => {
      frame = 0;
      let current = -1;
      sectionHeadings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < innerHeight * 0.3) current = i;
      });
      sideLinks.forEach((a, i) => a.toggleAttribute('aria-current', i === current));
    };
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    update();
  }

  // Copy each footnote into a margin note beside its reference. CSS shows these and hides the
  // footnote list only on screens wide enough to have a margin.
  const wide = matchMedia('(min-width: 78rem)');
  for (const ref of document.querySelectorAll<HTMLAnchorElement>('.prose a[data-footnote-ref]')) {
    const note = document.getElementById(decodeURIComponent(ref.hash.slice(1)));
    if (!note) continue;
    const content = note.cloneNode(true) as HTMLElement;
    content.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());
    const side = document.createElement('span');
    side.className = 'sidenote';
    side.id = `side-${note.id}`;
    side.innerHTML =
      `<span class="sidenote-num">${ref.textContent}</span> ` +
      [...content.querySelectorAll('p')].map((p) => p.innerHTML.trim()).join('<br>');
    (ref.closest('sup') ?? ref).after(side);
    ref.addEventListener('click', (e) => {
      if (!wide.matches) return;
      e.preventDefault();
      side.classList.remove('flash');
      void side.offsetWidth;
      side.classList.add('flash');
    });
  }

  const status = document.getElementById('copy-status');

  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrap = document.createElement('div');
    wrap.className = 'code-wrap';
    pre.replaceWith(wrap);
    wrap.append(pre);

    const btn = document.createElement('button');
    btn.className = 'copy-btn';
    btn.type = 'button';
    btn.textContent = 'copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? '');
        btn.textContent = 'copied';
      } catch {
        btn.textContent = 'copy failed';
      }
      if (status) status.textContent = btn.textContent === 'copied' ? 'Code copied' : 'Copy failed';
      setTimeout(() => (btn.textContent = 'copy'), 1500);
    });
    wrap.append(btn);
  }
</script>

<style>
  article {
    position: relative;
  }

  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 2.25rem;
  }

  .tags {
    margin-top: -0.75rem;
  }

  .toc {
    margin: -0.5rem 0 2.5rem;
    padding-block: 0.25rem;
    border-block: 1px solid var(--rule);
  }

  .toc summary {
    padding-block: 0.6rem;
    cursor: pointer;
  }

  .toc summary:hover {
    color: var(--fg);
  }

  .toc ol {
    margin: 0 0 0.75rem;
    padding-left: 1.5rem;
    font-size: 1rem;
  }

  .toc li {
    padding-block: 0.2rem;
  }

  .toc li::marker {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8em;
  }

  .toc a {
    text-decoration: none;
  }

  .toc-side {
    display: none;
  }

  /* With room in the margins: contents on the left, footnotes as sidenotes on the right. */
  @media (min-width: 78rem) {
    .toc {
      display: none;
    }

    .toc-side {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      right: calc(100% + 3rem);
      width: 13rem;
    }

    .toc-side-inner {
      position: sticky;
      top: 2rem;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
    }

    .toc-side p {
      margin: 0 0 0.75rem;
    }

    .toc-side ol {
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 0.95rem;
      line-height: 1.35;
    }

    .toc-side li {
      padding-block: 0.3rem;
    }

    .toc-side a {
      display: block;
      padding-left: 0.75rem;
      border-left: 1px solid var(--rule);
      color: var(--muted);
      text-decoration: none;
    }

    .toc-side a:hover {
      color: var(--fg);
    }

    .toc-side a[aria-current] {
      color: var(--fg);
      border-left-color: var(--accent);
    }
  }

  .after {
    margin-top: 4rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .after .section-label {
    margin-top: 1.5rem;
  }

  .after p {
    font-size: 1.05rem;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
  }

  .pager a {
    display: block;
    padding-block: 0.6rem;
    text-decoration: none;
    color: var(--fg);
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .pager span {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pager .newer {
    grid-column: 2;
    text-align: right;
  }

  .pager .all {
    grid-column: 1 / -1;
    padding-block: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pager a:hover,
  .pager a:hover span {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .newer {
      grid-column: 1;
      grid-row: 1;
      text-align: left;
    }
  }

  .draft {
    color: var(--accent);
  }

</style>
