---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import WorkList from '../components/WorkList.astro';
import { SITE } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 8);
---

<Base>
  <section class="intro">
    <h1>{SITE.name}</h1>
    <p class="role meta">{SITE.role}</p>
    <p class="tagline">{SITE.tagline}</p>
  </section>

  <h2 class="section-label">writing</h2>
  <PostList posts={posts} />
  <p class="more meta"><a href="/writing">all writing →</a></p>

  <h2 class="section-label">work</h2>
  <WorkList limit={3} />
  <p class="more meta"><a href="/work">all work →</a></p>
</Base>

<style>
  .intro h1 {
    font-size: 2rem;
    margin-bottom: 0.25rem;
  }

  .role {
    margin-bottom: 1.25rem;
  }

  .tagline {
    font-size: 1.3rem;
    line-height: 1.5;
    max-width: 34rem;
  }

  .more {
    margin-top: 1rem;
  }

  .more a {
    text-decoration: none;
  }
</style>
