---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

const { links } = SITE;
const contact = [
  { label: 'github', url: links.github, text: links.github.replace('https://', '') },
  { label: 'linkedin', url: links.linkedin, text: 'linkedin' },
  { label: links.social.label.toLowerCase(), url: links.social.url, text: links.social.url.replace('https://', '') },
  { label: 'email', url: links.email && `mailto:${links.email}`, text: links.email },
  { label: 'résumé', url: links.resume, text: 'pdf' },
].filter((c) => c.url);
---

<Base title="About" description={`About ${SITE.name}.`}>
  <h1>About</h1>
  <p class="meta">{SITE.role}</p>

  <div class="prose">
    <p>
      I'm a machine learning engineer. I've spent about ten years building ML systems in financial services,
      and I served thirteen years in the U.S. Army and National Guard.
    </p>
    <p>
      These days most of my curiosity goes to how software gets built now that AI writes so much of it: how you
      decide what correct means for a system, and how you find out whether it is. I also like digging into code, papers, and algorithms to understand how
      things actually work.
    </p>
    <p>{SITE.blogName} is where I write that down.</p>
  </div>

  <h2 class="section-label">elsewhere</h2>
  <dl>
    {
      contact.map(({ label, url, text }) => (
        <>
          <dt>{label}</dt>
          <dd>
            <a href={url}>{text}</a>
          </dd>
        </>
      ))
    }
  </dl>

  <p class="disclaimer meta">{SITE.disclaimer}</p>
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .disclaimer {
    margin-top: 3rem;
  }
</style>
