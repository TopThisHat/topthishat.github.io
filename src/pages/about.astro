---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

const { links } = SITE;
const contact = [
  { label: 'github', url: links.github, text: links.github.replace('https://', '') },
  { label: 'linkedin', url: links.linkedin, text: 'linkedin' },
  { label: links.social.label.toLowerCase(), url: links.social.url, text: links.social.url.replace('https://', '') },
  { label: 'email', url: links.email && `mailto:${links.email}`, text: links.email },
  { label: 'résumé', url: links.resume, text: 'pdf' },
].filter((c) => c.url);
---

<Base title="About" description={`About ${SITE.name}.`}>
  <h1>About</h1>
  <p class="meta">{SITE.role}</p>

  <div class="prose">
    <p>
      I'm a principal ML engineer who has spent the last decade building NLP and GenAI systems in financial
      services. Right now that means agents, hybrid retrieval, and a news intelligence platform that reads
      500,000 articles a day so thousands of advisors don't have to.
    </p>
    <p>
      Before that I led an NLP engineering team at Capital One, where a configurable pipeline framework we built
      became a U.S. patent, and did applied ML at PwC, KPMG, Grant Thornton, and AT&amp;T. I studied mathematics at
      Georgia State, and served thirteen years in the U.S. Army and National Guard, including a deployment to
      Afghanistan.
    </p>
    <p>
      I also co-created an internal agentic coding tool that grew to 16,000 developers. That's most of the reason
      this blog exists: I'm interested in what happens when software starts writing software, and in the
      unglamorous engineering that makes these systems trustworthy.
    </p>
    <p>
      <em>{SITE.blogName}</em> is where I write that down: what holds up in production, what quietly breaks, and
      the engineering in between.
    </p>
  </div>

  <h2 class="section-label">elsewhere</h2>
  <dl>
    {
      contact.map(({ label, url, text }) => (
        <>
          <dt>{label}</dt>
          <dd>
            <a href={url}>{text}</a>
          </dd>
        </>
      ))
    }
  </dl>

  <p class="disclaimer meta">{SITE.disclaimer}</p>
</Base>

<style>
  dl {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0.5rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
  }

  .disclaimer {
    margin-top: 3rem;
  }
</style>
