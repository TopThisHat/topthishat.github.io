---
// The feed-forward width rule as a calculator: plain or gated block, Shazeer's
// 2/3 reduction, Llama's ffn_dim_multiplier and multiple_of rounding, with
// presets that reproduce the numbers in real configuration files.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;

type Preset = {
  name: string;
  d: number;
  mult: number;
  gated: boolean;
  reduce: boolean;
  ffnMult: number;
  multipleOf: number;
  layers: number;
  expect: number;
  source: string;
};

const presets: Preset[] = [
  { name: 'GPT-2 small', d: 768, mult: 4, gated: false, reduce: false, ffnMult: 1, multipleOf: 1, layers: 12, expect: 3072, source: 'openai/gpt-2 model.py: mlp(x, nx * 4), GELU, two matrices' },
  { name: 'PaLM 540B', d: 18432, mult: 4, gated: true, reduce: false, ffnMult: 1, multipleOf: 1, layers: 118, expect: 73728, source: 'PaLM paper: SwiGLU with d_ff always 4 × d_model, no reduction' },
  { name: 'LLaMA 1 7B', d: 4096, mult: 4, gated: true, reduce: true, ffnMult: 1, multipleOf: 256, layers: 32, expect: 11008, source: 'llama/model.py: int(2 · 4d / 3), rounded up to a multiple of 256' },
  { name: 'Llama 2 70B', d: 8192, mult: 4, gated: true, reduce: true, ffnMult: 1.3, multipleOf: 4096, layers: 80, expect: 28672, source: 'Llama 2 config: ffn_dim_multiplier 1.3 and multiple_of 4096 from the reference config' },
  { name: 'Llama 3 8B', d: 4096, mult: 4, gated: true, reduce: true, ffnMult: 1.3, multipleOf: 1024, layers: 32, expect: 14336, source: 'Llama 3 paper, Table 3: FFN dimension 14,336' },
  { name: 'Mistral 7B', d: 4096, mult: 3.5, gated: true, reduce: false, ffnMult: 1, multipleOf: 1, layers: 32, expect: 14336, source: 'config.json: intermediate_size 14336, hidden_act silu; the paper never names the activation' },
  { name: 'OLMo 7B', d: 4096, mult: 4, gated: true, reduce: true, ffnMult: 1, multipleOf: 128, layers: 32, expect: 11008, source: 'OLMo paper §2.1: about 8/3 d, raised to the closest multiple of 128' },
  { name: 'DeepSeek 7B', d: 4096, mult: 4, gated: true, reduce: true, ffnMult: 1, multipleOf: 256, layers: 30, expect: 11008, source: 'DeepSeek LLM §2.2: SwiGLU with an intermediate dimension of 8/3 d' },
  { name: 'Gemma 2 9B', d: 3584, mult: 4, gated: true, reduce: false, ffnMult: 1, multipleOf: 1, layers: 42, expect: 14336, source: 'config.json: intermediate_size 14336, GeGLU; the tech report quotes 28672, counting gate and up together' },
  { name: 'Gemma 2 27B', d: 4608, mult: 8, gated: true, reduce: false, ffnMult: 1, multipleOf: 1, layers: 46, expect: 36864, source: 'config.json: intermediate_size 36864, 8 × d' },
  { name: 'gpt-oss-120b expert', d: 2880, mult: 1, gated: true, reduce: false, ffnMult: 1, multipleOf: 1, layers: 36, expect: 2880, source: 'config.json: each expert has intermediate_size 2880, equal to d; clamped SwiGLU with α = 1.702' },
];

// Llama's rule, verbatim: int(2h/3), then int(multiplier · h), then round up.
function hiddenOf(p: { d: number; mult: number; gated: boolean; reduce: boolean; ffnMult: number; multipleOf: number }): number {
  let h = Math.floor(p.mult * p.d);
  if (p.gated && p.reduce) h = Math.floor((2 * h) / 3);
  h = Math.floor(p.ffnMult * h);
  const m = Math.max(1, p.multipleOf);
  return m * Math.floor((h + m - 1) / m);
}

// Checked at build time: every preset must reproduce its configuration file.
for (const p of presets) {
  const got = hiddenOf(p);
  if (got !== p.expect) throw new Error(`WidthCalc preset ${p.name}: formula gives ${got}, config says ${p.expect}`);
}
const def = presets[2];
---

<figure class="widthcalc" data-widthcalc data-presets={JSON.stringify(presets)}>
  <div class="presets">
    <span class="meta">presets</span>
    {presets.map((p, i) => <button type="button" data-preset={i} aria-pressed={i === 2 ? 'true' : 'false'}>{p.name}</button>)}
  </div>
  <div class="demo-controls inputs">
    <label>
      <span class="meta">d_model</span>
      <input type="number" min="64" max="65536" step="64" value={def.d} data-d />
    </label>
    <label>
      <span class="meta">multiplier</span>
      <input type="number" min="0.5" max="16" step="0.5" value={def.mult} data-mult />
    </label>
    <fieldset class="radio">
      <legend class="meta">block</legend>
      <label><input type="radio" name="block" value="plain" data-block /> plain, 2 matrices</label>
      <label><input type="radio" name="block" value="gated" checked data-block /> gated, 3 matrices</label>
    </fieldset>
    <label class="check">
      <input type="checkbox" checked data-reduce /> <span class="meta">2/3 reduction</span>
    </label>
    <label>
      <span class="meta">ffn_dim_multiplier</span>
      <input type="number" min="0.5" max="4" step="0.05" value={def.ffnMult} data-ffnmult />
    </label>
    <label>
      <span class="meta">multiple_of</span>
      <select data-multipleof>
        {[1, 128, 256, 1024, 4096].map((m) => <option value={m} selected={m === def.multipleOf}>{m}</option>)}
      </select>
    </label>
    <label>
      <span class="meta">layers</span>
      <input type="number" min="1" max="256" step="1" value={def.layers} data-layers />
    </label>
  </div>
  <div class="result">
    <div class="big">
      <span class="meta">hidden width</span>
      <strong data-hidden>{hiddenOf(def).toLocaleString('en-US')}</strong>
      <span class="meta" data-ratio>= {(hiddenOf(def) / def.d).toFixed(3)} × d</span>
    </div>
    <dl class="stats" data-stats></dl>
    <div class="meta source" data-source>{def.source}</div>
  </div>
  <div class="matrices" data-matrices aria-hidden="true"></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Preset = {
    name: string;
    d: number;
    mult: number;
    gated: boolean;
    reduce: boolean;
    ffnMult: number;
    multipleOf: number;
    layers: number;
    expect: number;
    source: string;
  };

  function hiddenOf(p: { d: number; mult: number; gated: boolean; reduce: boolean; ffnMult: number; multipleOf: number }): number {
    let h = Math.floor(p.mult * p.d);
    if (p.gated && p.reduce) h = Math.floor((2 * h) / 3);
    h = Math.floor(p.ffnMult * h);
    const m = Math.max(1, p.multipleOf);
    return m * Math.floor((h + m - 1) / m);
  }

  const num = (n: number) => n.toLocaleString('en-US');
  const big = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(2)}B` : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : num(n));

  for (const root of document.querySelectorAll<HTMLElement>('[data-widthcalc]')) {
    const presets: Preset[] = JSON.parse(root.dataset.presets!);
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const inD = $<HTMLInputElement>('[data-d]');
    const inMult = $<HTMLInputElement>('[data-mult]');
    const blocks = [...root.querySelectorAll<HTMLInputElement>('[data-block]')];
    const inReduce = $<HTMLInputElement>('[data-reduce]');
    const inFfn = $<HTMLInputElement>('[data-ffnmult]');
    const inMo = $<HTMLSelectElement>('[data-multipleof]');
    const inLayers = $<HTMLInputElement>('[data-layers]');
    const outHidden = $<HTMLElement>('[data-hidden]');
    const outRatio = $<HTMLElement>('[data-ratio]');
    const outStats = $<HTMLElement>('[data-stats]');
    const outSource = $<HTMLElement>('[data-source]');
    const matrices = $<HTMLElement>('[data-matrices]');
    const presetButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    let source = presets[2].source;

    const read = () => ({
      d: Math.max(1, Number(inD.value) || 1),
      mult: Math.max(0, Number(inMult.value) || 0),
      gated: blocks.find((b) => b.checked)!.value === 'gated',
      reduce: inReduce.checked,
      ffnMult: Math.max(0, Number(inFfn.value) || 1),
      multipleOf: Number(inMo.value) || 1,
      layers: Math.max(1, Number(inLayers.value) || 1),
    });

    function drawMatrices(d: number, h: number, gated: boolean) {
      // Scale so the widest matrix fills the strip: side lengths proportional to d and h.
      matrices.replaceChildren();
      const maxDim = Math.max(d, h);
      const scale = 100 / maxDim; // percent of the strip's width per unit
      const mk = (label: string, w: number, ht: number) => {
        const wrap = document.createElement('div');
        wrap.className = 'mat';
        const box = document.createElement('div');
        box.className = 'box';
        box.style.width = `${w * scale}%`;
        box.style.paddingTop = `${ht * scale}%`;
        const cap = document.createElement('div');
        cap.className = 'meta';
        cap.textContent = label;
        wrap.append(box, cap);
        matrices.append(wrap);
      };
      mk(`W1 (gate): ${num(d)} × ${num(h)}`, h, d);
      if (gated) mk(`V (up): ${num(d)} × ${num(h)}`, h, d);
      mk(`W2 (down): ${num(h)} × ${num(d)}`, d, h);
    }

    function update() {
      const p = read();
      inReduce.disabled = !p.gated;
      const h = hiddenOf(p);
      const perLayer = (p.gated ? 3 : 2) * p.d * h;
      const attn = 4 * p.d * p.d;
      outHidden.textContent = num(h);
      outRatio.textContent = `= ${(h / p.d).toFixed(3)} × d`;
      const rows: [string, string][] = [
        ['FFN parameters per layer', `${big(perLayer)} (${p.gated ? '3' : '2'} · d · h)`],
        ['FFN parameters, all layers', big(perLayer * p.layers)],
        ['attention parameters per layer', `${big(attn)} (4 · d²)`],
        ['FFN share of a layer', `${((100 * perLayer) / (perLayer + attn)).toFixed(1)}%`],
      ];
      outStats.replaceChildren(
        ...rows.flatMap(([k, v]) => {
          const dt = document.createElement('dt');
          dt.className = 'meta';
          dt.textContent = k;
          const dd = document.createElement('dd');
          dd.textContent = v;
          return [dt, dd];
        }),
      );
      outSource.textContent = source;
      drawMatrices(p.d, h, p.gated);
    }

    function applyPreset(i: number) {
      const p = presets[i];
      inD.value = String(p.d);
      inMult.value = String(p.mult);
      blocks.forEach((b) => (b.checked = b.value === (p.gated ? 'gated' : 'plain')));
      inReduce.checked = p.reduce;
      inFfn.value = String(p.ffnMult);
      inMo.value = String(p.multipleOf);
      inLayers.value = String(p.layers);
      source = `${p.name}: ${p.source}`;
      presetButtons.forEach((b, k) => b.setAttribute('aria-pressed', k === i ? 'true' : 'false'));
      update();
    }

    presetButtons.forEach((b, i) => b.addEventListener('click', () => applyPreset(i)));
    for (const el of [inD, inMult, inReduce, inFfn, inMo, inLayers, ...blocks])
      el.addEventListener('input', () => {
        source = 'custom';
        presetButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
        update();
      });
    applyPreset(2);
  }
</script>

<style>
  .widthcalc {
    margin: 2.25rem 0;
    font-family: var(--font-mono);
    --s1: #2a78d6;
    --s2: #e87ba4;
    --s3: #17703a;
    --s4: #d9822b;
  }

  @media (prefers-color-scheme: dark) {
    .widthcalc {
      --s1: #3987e5;
      --s2: #d55181;
      --s3: #008300;
      --s4: #e8963e;
    }
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .presets button {
    padding: 0.25rem 0.5rem;
    font: 500 0.72rem var(--font-mono);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 4px;
    cursor: pointer;
  }

  .presets button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .presets button[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .inputs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    align-items: end;
  }

  .inputs > label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .inputs input[type='number'],
  .inputs select {
    width: 7rem;
    padding: 0.35rem 0.5rem;
    font: 500 0.85rem var(--font-mono);
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .inputs label.check {
    flex-direction: row;
    align-items: center;
    gap: 0.35rem;
    padding-bottom: 0.45rem;
  }

  .inputs input[type='checkbox'] {
    accent-color: var(--accent);
    margin: 0;
  }

  .radio {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    align-items: center;
    margin: 0;
    padding: 0.2rem 0.5rem 0.3rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .radio legend {
    padding: 0 0.25rem;
  }

  .radio label {
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    gap: 0.25rem;
  }

  .radio input {
    accent-color: var(--accent);
    margin: 0;
  }

  .result {
    padding: 0.75rem 0.9rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  .big {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .big strong {
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .stats {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.15rem 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.78rem;
  }

  .stats :global(dd) {
    margin: 0;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 34rem) {
    .stats {
      grid-template-columns: 1fr;
    }

    .stats :global(dd) {
      margin-bottom: 0.3rem;
    }
  }

  .source {
    margin-top: 0.6rem;
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .matrices {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 1.5rem;
    margin-top: 0.9rem;
  }

  .matrices :global(.mat) {
    flex: 1 1 10rem;
    max-width: 14rem;
  }

  .matrices :global(.box) {
    background: color-mix(in srgb, var(--s1) 35%, var(--surface));
    border: 1px solid var(--s1);
    border-radius: 2px;
  }

  .matrices :global(.mat:nth-child(2) .box) {
    background: color-mix(in srgb, var(--s2) 35%, var(--surface));
    border-color: var(--s2);
  }

  .matrices :global(.mat:last-child .box) {
    background: color-mix(in srgb, var(--s3) 35%, var(--surface));
    border-color: var(--s3);
  }

  .matrices :global(.meta) {
    margin-top: 0.25rem;
    font-size: 0.7rem;
  }

  figcaption {
    margin-top: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
