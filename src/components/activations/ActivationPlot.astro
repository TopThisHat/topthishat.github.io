---
// Activation functions and their derivatives on [-4, 4]. The default curves are
// drawn on the server so the figure reads without JavaScript; the script adds
// the crosshair, the legend toggles, the β slider for Swish, and the GELU
// approximation switch.
interface Props {
  show?: string; // comma-separated subset of sigmoid,tanh,relu,gelu,swish,relu2
  beta?: boolean; // slider for Swish's β
  gelu?: boolean; // exact / tanh / sigmoid approximation switch for GELU
  derivative?: boolean; // draw f' dashed
  caption?: string;
}
const { show = 'relu,gelu,swish', beta = false, gelu = false, derivative = true, caption } = Astro.props;

const ALL = ['sigmoid', 'tanh', 'relu', 'gelu', 'swish', 'relu2'] as const;
type Key = (typeof ALL)[number];
const keys = show
  .split(',')
  .map((s) => s.trim())
  .filter((s): s is Key => (ALL as readonly string[]).includes(s));

const NAMES: Record<Key, string> = {
  sigmoid: 'sigmoid σ(x)',
  tanh: 'tanh x',
  relu: 'ReLU max(0, x)',
  gelu: 'GELU x·Φ(x)',
  swish: 'Swish x·σ(βx)',
  relu2: 'ReLU² max(0, x)²',
};
const SLOT: Record<Key, number> = { sigmoid: 4, tanh: 5, relu: 1, gelu: 2, swish: 3, relu2: 6 };

// The same math as in the script below, for the server-rendered curves.
const erf = (x: number) => {
  const s = Math.sign(x);
  x = Math.abs(x);
  const t = 1 / (1 + 0.3275911 * x);
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
  return s * y;
};
const sig = (x: number) => 1 / (1 + Math.exp(-x));
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
const phi = (x: number) => Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI);
const F: Record<Key, (x: number) => number> = {
  sigmoid: sig,
  tanh: Math.tanh,
  relu: (x) => Math.max(0, x),
  gelu: (x) => x * Phi(x),
  swish: (x) => x * sig(x),
  relu2: (x) => Math.max(0, x) ** 2,
};
const D: Record<Key, (x: number) => number> = {
  sigmoid: (x) => sig(x) * (1 - sig(x)),
  tanh: (x) => 1 - Math.tanh(x) ** 2,
  relu: (x) => (x > 0 ? 1 : 0),
  gelu: (x) => Phi(x) + x * phi(x),
  swish: (x) => sig(x) + x * sig(x) * (1 - sig(x)),
  relu2: (x) => 2 * Math.max(0, x),
};

const W = 640;
const H = 340;
const L = 44;
const R = 16;
const T = 22;
const B = 36;
const X0 = -4;
const X1 = 4;
const Y0 = -1.5;
const Y1 = 4;
const px = (x: number) => L + ((x - X0) / (X1 - X0)) * (W - L - R);
const py = (y: number) => T + ((Y1 - y) / (Y1 - Y0)) * (H - T - B);
const N = 321;
const xs = Array.from({ length: N }, (_, i) => X0 + ((X1 - X0) * i) / (N - 1));
const pathOf = (f: (x: number) => number) =>
  xs.map((x, i) => `${i ? 'L' : 'M'}${px(x).toFixed(1)},${py(Math.max(Y0 - 1, Math.min(Y1 + 1, f(x)))).toFixed(1)}`).join('');
const clipped = keys.some((k) => xs.some((x) => F[k](x) > Y1 || F[k](x) < Y0));
const xTicks = [-4, -3, -2, -1, 0, 1, 2, 3, 4];
const uid = `gelu-${Math.random().toString(36).slice(2, 8)}`;
const yTicks = [-1, 0, 1, 2, 3, 4];
---

<figure class="ap" data-activation-plot data-keys={keys.join(',')} data-derivative={derivative ? '1' : '0'}>
  <div class="controls">
    {
      beta && keys.includes('swish') && (
        <label class="slider">
          <span class="meta">
            β = <strong data-beta-label>1.00</strong>
          </span>
          <input type="range" min="0" max="4" step="0.05" value="1" data-beta />
          <span class="meta" data-beta-note>Swish with β = 1 is SiLU. β → 0 gives x/2, β → ∞ gives ReLU.</span>
        </label>
      )
    }
    {
      gelu && keys.includes('gelu') && (
        <div class="radios meta" role="radiogroup" aria-label="GELU form">
          <span>GELU as</span>
          <label>
            <input type="radio" name={uid} value="exact" checked data-gelu /> exact x·Φ(x)
          </label>
          <label>
            <input type="radio" name={uid} value="tanh" data-gelu /> tanh approximation
          </label>
          <label>
            <input type="radio" name={uid} value="sigmoid" data-gelu /> x·σ(1.702x)
          </label>
          <span data-gelu-err></span>
        </div>
      )
    }
  </div>
  <div class="chart">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Activation functions and their derivatives on the interval from minus four to four" data-svg>
      <defs>
        <clipPath id="ap-clip">
          <rect x={L} y={T} width={W - L - R} height={H - T - B} />
        </clipPath>
      </defs>
      {yTicks.map((v) => <line x1={L} x2={W - R} y1={py(v)} y2={py(v)} class="grid" />)}
      {xTicks.map((v) => <line x1={px(v)} x2={px(v)} y1={T} y2={H - B} class="grid" />)}
      <line x1={L} x2={W - R} y1={py(0)} y2={py(0)} class="axis" />
      <line x1={px(0)} x2={px(0)} y1={T} y2={H - B} class="axis" />
      {yTicks.map((v) => <text x={L - 6} y={py(v) + 4} class="tick" text-anchor="end">{v}</text>)}
      {xTicks.map((v) => <text x={px(v)} y={H - B + 16} class="tick" text-anchor="middle">{v}</text>)}
      <text x={W - R} y={H - 4} class="tick" text-anchor="end">x</text>
      <g clip-path="url(#ap-clip)" data-curves>
        {
          keys.map((k) => (
            <g data-fn={k} class={`fn s${SLOT[k]}`}>
              {derivative && <path d={pathOf(D[k])} class="series deriv" data-kind="d" />}
              <path d={pathOf(F[k])} class="series" data-kind="f" />
            </g>
          ))
        }
        <g data-mins>
          {keys.includes('swish') && (
            <g data-min="swish" class="s3">
              <circle cx={px(-1.278)} cy={py(-0.278)} r="3.5" class="mindot" />
              <text x={px(-1.278)} y={py(-0.278) + 16} class="minlabel" text-anchor="middle">
                min −0.278
              </text>
            </g>
          )}
          {keys.includes('gelu') && (
            <g data-min="gelu" class="s2">
              <circle cx={px(-0.752)} cy={py(-0.17)} r="3.5" class="mindot" />
              <text x={px(-0.752)} y={py(-0.17) - 8} class="minlabel" text-anchor="middle">
                min −0.170
              </text>
            </g>
          )}
        </g>
      </g>
      <g data-cross display="none">
        <line x1="0" x2="0" y1={T} y2={H - B} class="cross" />
      </g>
    </svg>
  </div>
  <div class="legend" data-legend>
    {
      keys.map((k) => (
        <label class={`meta s${SLOT[k]}`}>
          <input type="checkbox" checked data-toggle={k} />
          <i class="line" />
          {NAMES[k]}
        </label>
      ))
    }
    {derivative && (
      <span class="meta key">
        <i class="line" /> f &nbsp; <i class="line dashed" /> f′
      </span>
    )}
  </div>
  <div class="readouts meta" data-readouts>
    <span data-clipnote hidden={!clipped}>y axis clipped to [−1.5, 4]</span>
    <span data-hover>move the pointer over the chart to read values</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
  type Key = 'sigmoid' | 'tanh' | 'relu' | 'gelu' | 'swish' | 'relu2';
  const erf = (x: number) => {
    const s = Math.sign(x);
    x = Math.abs(x);
    const t = 1 / (1 + 0.3275911 * x);
    const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
    return s * y;
  };
  const sig = (x: number) => 1 / (1 + Math.exp(-x));
  const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
  const phi = (x: number) => Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI);
  const C = Math.sqrt(2 / Math.PI);

  type Params = { beta: number; gelu: 'exact' | 'tanh' | 'sigmoid' };
  const F: Record<Key, (x: number, p: Params) => number> = {
    sigmoid: (x) => sig(x),
    tanh: (x) => Math.tanh(x),
    relu: (x) => Math.max(0, x),
    gelu: (x, p) =>
      p.gelu === 'exact' ? x * Phi(x) : p.gelu === 'tanh' ? 0.5 * x * (1 + Math.tanh(C * (x + 0.044715 * x ** 3))) : x * sig(1.702 * x),
    swish: (x, p) => x * sig(p.beta * x),
    relu2: (x) => Math.max(0, x) ** 2,
  };
  const D: Record<Key, (x: number, p: Params) => number> = {
    sigmoid: (x) => sig(x) * (1 - sig(x)),
    tanh: (x) => 1 - Math.tanh(x) ** 2,
    relu: (x) => (x > 0 ? 1 : 0),
    gelu: (x, p) => {
      if (p.gelu === 'exact') return Phi(x) + x * phi(x);
      if (p.gelu === 'tanh') {
        const u = C * (x + 0.044715 * x ** 3);
        const du = C * (1 + 3 * 0.044715 * x * x);
        const th = Math.tanh(u);
        return 0.5 * (1 + th) + 0.5 * x * (1 - th * th) * du;
      }
      const s = sig(1.702 * x);
      return s + 1.702 * x * s * (1 - s);
    },
    swish: (x, p) => {
      const s = sig(p.beta * x);
      return s + p.beta * x * s * (1 - s);
    },
    relu2: (x) => 2 * Math.max(0, x),
  };

  const W = 640;
  const H = 340;
  const L = 44;
  const R = 16;
  const T = 22;
  const B = 36;
  const X0 = -4;
  const X1 = 4;
  const Y0 = -1.5;
  const Y1 = 4;
  const px = (x: number) => L + ((x - X0) / (X1 - X0)) * (W - L - R);
  const py = (y: number) => T + ((Y1 - y) / (Y1 - Y0)) * (H - T - B);
  const N = 321;
  const xs = Array.from({ length: N }, (_, i) => X0 + ((X1 - X0) * i) / (N - 1));
  const pathOf = (f: (x: number) => number) =>
    xs.map((x, i) => `${i ? 'L' : 'M'}${px(x).toFixed(1)},${py(Math.max(Y0 - 1, Math.min(Y1 + 1, f(x)))).toFixed(1)}`).join('');
  const fmt = (v: number) => (Math.abs(v) < 0.0005 ? '0.000' : v.toFixed(3));
  const ns = 'http://www.w3.org/2000/svg';

  for (const root of document.querySelectorAll<HTMLElement>('[data-activation-plot]')) {
    const keys = (root.dataset.keys || '').split(',').filter(Boolean) as Key[];
    const withDeriv = root.dataset.derivative === '1';
    const svg = root.querySelector<SVGSVGElement>('[data-svg]')!;
    const betaIn = root.querySelector<HTMLInputElement>('[data-beta]');
    const betaLabel = root.querySelector<HTMLElement>('[data-beta-label]');
    const geluIns = [...root.querySelectorAll<HTMLInputElement>('[data-gelu]')];
    const geluErr = root.querySelector<HTMLElement>('[data-gelu-err]');
    const cross = root.querySelector<SVGGElement>('[data-cross]')!;
    const crossLine = cross.querySelector('line')!;
    const hover = root.querySelector<HTMLElement>('[data-hover]')!;
    const clipnote = root.querySelector<HTMLElement>('[data-clipnote]')!;
    const toggles = [...root.querySelectorAll<HTMLInputElement>('[data-toggle]')];
    const p: Params = { beta: 1, gelu: 'exact' };
    const visible = new Set<Key>(keys);

    // One crosshair dot per curve.
    const dots = new Map<string, SVGCircleElement>();
    for (const k of keys) {
      for (const kind of withDeriv ? ['f', 'd'] : ['f']) {
        const c = document.createElementNS(ns, 'circle');
        c.setAttribute('r', kind === 'f' ? '4' : '3');
        c.setAttribute('class', `dot ${kind === 'd' ? 'deriv' : ''}`);
        const g = root.querySelector(`[data-fn="${k}"]`)!;
        c.setAttribute('style', `fill: ${getComputedStyle(g).stroke}`);
        cross.append(c);
        dots.set(`${k}:${kind}`, c);
      }
    }

    function redraw() {
      let clipped = false;
      for (const k of keys) {
        const g = root.querySelector<SVGGElement>(`[data-fn="${k}"]`)!;
        g.toggleAttribute('hidden', !visible.has(k));
        const f = g.querySelector<SVGPathElement>('[data-kind="f"]')!;
        f.setAttribute('d', pathOf((x) => F[k](x, p)));
        const d = g.querySelector<SVGPathElement>('[data-kind="d"]');
        if (d) d.setAttribute('d', pathOf((x) => D[k](x, p)));
        if (visible.has(k) && xs.some((x) => F[k](x, p) > Y1 || F[k](x, p) < Y0)) clipped = true;
      }
      clipnote.hidden = !clipped;
      // Minima move with β; GELU's is fixed.
      const sm = root.querySelector<SVGGElement>('[data-min="swish"]');
      if (sm) {
        const show = visible.has('swish') && p.beta > 0.05;
        sm.toggleAttribute('hidden', !show);
        if (show) {
          const xm = -1.278 / p.beta;
          const ym = -0.278 / p.beta;
          sm.querySelector('circle')!.setAttribute('cx', String(px(xm)));
          sm.querySelector('circle')!.setAttribute('cy', String(py(ym)));
          const t = sm.querySelector('text')!;
          t.setAttribute('x', String(px(xm)));
          t.setAttribute('y', String(py(ym) + 16));
          t.textContent = `min ${ym.toFixed(3)}`;
        }
      }
      const gm = root.querySelector<SVGGElement>('[data-min="gelu"]');
      if (gm) gm.toggleAttribute('hidden', !visible.has('gelu') || p.gelu !== 'exact');
      if (geluErr) {
        if (p.gelu === 'exact') geluErr.textContent = '';
        else {
          let err = 0;
          for (let i = 0; i <= 800; i++) {
            const x = X0 + ((X1 - X0) * i) / 800;
            err = Math.max(err, Math.abs(F.gelu(x, p) - x * Phi(x)));
          }
          geluErr.textContent = `max |error| on [−4, 4]: ${err.toExponential(2)}`;
        }
      }
    }

    function readout(x: number) {
      crossLine.setAttribute('x1', String(px(x)));
      crossLine.setAttribute('x2', String(px(x)));
      const parts: string[] = [`x = ${fmt(x)}`];
      for (const k of keys) {
        const on = visible.has(k);
        const fv = F[k](x, p);
        const dv = D[k](x, p);
        const df = dots.get(`${k}:f`)!;
        df.toggleAttribute('hidden', !on || fv > Y1 || fv < Y0);
        df.setAttribute('cx', String(px(x)));
        df.setAttribute('cy', String(py(fv)));
        const dd = dots.get(`${k}:d`);
        if (dd) {
          dd.toggleAttribute('hidden', !on || dv > Y1 || dv < Y0);
          dd.setAttribute('cx', String(px(x)));
          dd.setAttribute('cy', String(py(dv)));
        }
        if (on) parts.push(`${k}: f ${fmt(fv)}${withDeriv ? `, f′ ${fmt(dv)}` : ''}`);
      }
      hover.textContent = parts.join(' · ');
    }

    function onMove(ev: PointerEvent) {
      const r = svg.getBoundingClientRect();
      const vx = ((ev.clientX - r.left) / r.width) * W;
      const x = Math.max(X0, Math.min(X1, X0 + ((vx - L) / (W - L - R)) * (X1 - X0)));
      cross.removeAttribute('display');
      readout(x);
    }
    svg.addEventListener('pointermove', onMove);
    svg.addEventListener('pointerdown', onMove);
    svg.addEventListener('pointerleave', () => {
      cross.setAttribute('display', 'none');
      hover.textContent = 'move the pointer over the chart to read values';
    });

    for (const t of toggles) {
      t.addEventListener('change', () => {
        const k = t.dataset.toggle as Key;
        if (t.checked) visible.add(k);
        else visible.delete(k);
        redraw();
      });
    }
    if (betaIn) {
      betaIn.addEventListener('input', () => {
        p.beta = Number(betaIn.value);
        betaLabel!.textContent = p.beta.toFixed(2);
        redraw();
      });
    }
    for (const g of geluIns) {
      g.addEventListener('change', () => {
        if (g.checked) {
          p.gelu = g.value as Params['gelu'];
          redraw();
        }
      });
    }
    redraw();
  }
</script>

<style>
  .ap {
    margin: 2.25rem 0;
    font-family: var(--font-mono);
    --s1: #2a78d6;
    --s2: #e87ba4;
    --s3: #17703a;
    --s4: #d9822b;
    --s5: #7a5cc7;
    --s6: #8a8a80;
  }

  @media (prefers-color-scheme: dark) {
    .ap {
      --s1: #3987e5;
      --s2: #d55181;
      --s3: #008300;
      --s4: #e8963e;
      --s5: #9b7fe0;
      --s6: #9a9a90;
    }
  }

  .controls {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .controls:empty {
    display: none;
  }

  .slider {
    display: grid;
    gap: 0.2rem;
  }

  .slider strong {
    color: var(--fg);
  }

  input[type='range'] {
    width: 100%;
    max-width: 24rem;
    accent-color: var(--accent);
  }

  .radios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.9rem;
    align-items: center;
  }

  .radios input {
    accent-color: var(--accent);
    margin: 0 0.25rem 0 0;
  }

  .chart svg {
    display: block;
    width: 100%;
    height: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    touch-action: none;
  }

  .chart :global(.grid) {
    stroke: var(--rule);
    stroke-width: 1;
  }

  .chart :global(.axis) {
    stroke: var(--muted);
    stroke-width: 1;
  }

  .chart :global(.tick) {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--muted);
  }

  .chart :global(.series) {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .chart :global(.series.deriv) {
    stroke-width: 1.5;
    stroke-dasharray: 5 4;
    opacity: 0.85;
  }

  .chart :global(.fn[hidden]),
  .chart :global([data-min][hidden]),
  .chart :global(.dot[hidden]) {
    display: none;
  }

  .chart :global(.mindot) {
    fill: currentColor;
    stroke: var(--surface);
    stroke-width: 1.5;
  }

  .chart :global(.minlabel) {
    font-family: var(--font-mono);
    font-size: 10.5px;
    fill: currentColor;
  }

  .chart :global(.cross) {
    stroke: var(--fg);
    stroke-width: 1;
    opacity: 0.5;
  }

  .chart :global(.dot) {
    stroke: var(--surface);
    stroke-width: 2;
  }

  .ap :global(.s1) {
    color: var(--s1);
    stroke: var(--s1);
  }

  .ap :global(.s2) {
    color: var(--s2);
    stroke: var(--s2);
  }

  .ap :global(.s3) {
    color: var(--s3);
    stroke: var(--s3);
  }

  .ap :global(.s4) {
    color: var(--s4);
    stroke: var(--s4);
  }

  .ap :global(.s5) {
    color: var(--s5);
    stroke: var(--s5);
  }

  .ap :global(.s6) {
    color: var(--s6);
    stroke: var(--s6);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }

  .legend label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .legend input {
    accent-color: var(--accent);
    margin: 0;
  }

  .legend .key {
    margin-left: auto;
    color: var(--muted);
  }

  .ap :global(.line) {
    display: inline-block;
    width: 1rem;
    height: 0;
    vertical-align: middle;
    border-top: 2px solid currentColor;
  }

  .ap :global(.line.dashed) {
    border-top-style: dashed;
  }

  .readouts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    min-height: 1.4rem;
    margin-top: 0.4rem;
    font-size: 0.75rem;
  }

  .readouts [hidden] {
    display: none;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
