---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={{ wide }}>
  {typeof src === 'string' ? <img src={src} alt={alt} loading="lazy" /> : <Image src={src} alt={alt} />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  figure {
    margin: 2rem 0;
  }

  .wide {
    margin-inline: calc(var(--gutter) * -1);
  }

  img {
    display: block;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: 6px;
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
