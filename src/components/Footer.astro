---
import { SITE } from '../site.config';

const { links } = SITE;
const items = [
  { label: 'github', url: links.github },
  { label: 'linkedin', url: links.linkedin },
  { label: links.social.label.toLowerCase(), url: links.social.url },
  { label: 'email', url: links.email && `mailto:${links.email}` },
  { label: 'rss', url: '/rss.xml' },
].filter((l) => l.url);
---

<footer class="container">
  <nav aria-label="Elsewhere">
    {items.map(({ label, url }) => <a href={url}>{label}</a>)}
  </nav>
  <p>© {new Date().getFullYear()} {SITE.name}. {SITE.disclaimer}</p>
</footer>

<style>
  footer {
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    /* A rule the width of the text column, not the padded container. */
    background: linear-gradient(var(--rule), var(--rule)) center top / calc(100% - var(--gutter) * 2) 1px
      no-repeat;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    margin: -0.8rem 0 0.2rem -0.4rem;
  }

  /* Pad links to a 44px tap target. */
  a {
    padding: 0.8rem 0.4rem;
    text-decoration: none;
  }

  p {
    margin: 0;
  }
</style>
